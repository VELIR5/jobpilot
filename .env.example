# The Node.js 22 built-in SQLite runtime uses %LOCALAPPDATA%\\JobPilot\\jobpilot.db.
# Optional absolute override used when the production process and deployment task
# need to share one persistent directory.
# JOBPILOT_DATA_DIR="C:\\JobPilotData"
# DATABASE_URL is intentionally not used by the current runtime.
# SHA-256 of the shared access password users type to reach the sign-in page.
JOBPILOT_ACCESS_PASSWORD_HASH="sha256-of-your-access-password"
# SHA-256 invite password used when registering a user account.
JOBPILOT_INVITE_PASSWORD_HASH="sha256-of-your-invite-password"
JOBPILOT_SESSION_SECRET="random-session-signing-secret"
JOBPILOT_OWNER_EMAIL="owner@example.com"
# Optional background web collector. It uses only generic city/role queries, never a user's resume.
JOBPILOT_CATALOG_WEB_SEARCH="1"
JOBPILOT_MODEL_BASE_URL="https://your-openai-compatible-provider.example/v1"
JOBPILOT_MODEL_API_KEY="your-model-key-here"
JOBPILOT_MODEL_NAME="your-model-name"
JOBPILOT_MODEL_REASONING="none"
JOBPILOT_CATALOG_CITIES="东莞,广州,深圳"
JOBPILOT_CATALOG_ROLE_FAMILIES="人工智能,大模型,机器学习,算法,通信,后端,数据工程,平台工程"
JOBPILOT_CATALOG_WEB_SEARCH_MAX_QUERIES="6"
JOBPILOT_CATALOG_WEB_SEARCH_TIMEOUT_MS="90000"
# Scheduled catalog refresh. Configure sources in config/job-feeds.json or set JOBPILOT_JOB_FEEDS to JSON.
JOBPILOT_CATALOG_SCHEDULER="1"
JOBPILOT_CATALOG_REFRESH_MINUTES="60"
JOBPILOT_CATALOG_STALE_HOURS="48"
JOBPILOT_CATALOG_MAX_AGE_DAYS="45"
JOBPILOT_CATALOG_MAX_ACTIVE_JOBS="5000"
JOBPILOT_CATALOG_RETENTION_DAYS="90"
JOBPILOT_CATALOG_FETCH_CONCURRENCY="3"
JOBPILOT_CATALOG_REQUEST_TIMEOUT_MS="15000"
JOBPILOT_CATALOG_MAX_FEED_BYTES="4194304"
# Optional inline JSON overrides config/job-feeds.json. See config/job-feeds.example.json.
# JOBPILOT_JOB_FEEDS='{"feeds":[]}'
# Gmail one-click OAuth ("用 Google 连接"). JOBPILOT_PUBLIC_URL is your app's public origin and is used to
# build the redirect URI (<origin>/api/oauth/google/callback) — it must EXACTLY match a redirect URI you
# register in the Google Cloud OAuth client. The client id/secret come from that same OAuth client.
JOBPILOT_PUBLIC_URL="https://your-app.example"
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# WeChat mini-program credentials. Required only for the mini-program login exchange.
WECHAT_MINIAPP_APP_ID=""
WECHAT_MINIAPP_APP_SECRET=""
# Central platform sender via Resend. Non-Gmail users need no mailbox configuration: the applicant's email
# is used as Reply-To and receives a BCC copy of every relayed message.
RESEND_API_KEY=""
RESEND_FROM_ADDRESS="jobpilot@your-domain.example"
